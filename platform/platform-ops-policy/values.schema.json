{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy"
  ],
  "properties": {
    "policy": {
      "type": "object",
      "required": [
        "name",
        "namespace",
        "schedule",
        "retentionDays",
        "repositorySecretName",
        "snapshotClass",
        "preset"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "schedule": {
          "type": "string",
          "pattern": "^\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+$"
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "repositorySecretName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "snapshotClass": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "preset": {
          "type": "object",
          "required": [
            "name",
            "cpu",
            "memory"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            },
            "gpu": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

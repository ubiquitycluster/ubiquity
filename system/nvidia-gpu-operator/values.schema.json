{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "gpu-operator": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "driver": { "$ref": "#/definitions/enabledBlock" },
        "toolkit": { "$ref": "#/definitions/enabledBlock" },
        "devicePlugin": { "$ref": "#/definitions/enabledBlock" },
        "gfd": { "$ref": "#/definitions/enabledBlock" },
        "migManager": { "$ref": "#/definitions/enabledBlock" },
        "dcgmExporter": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "serviceMonitor": { "$ref": "#/definitions/enabledBlock" }
          }
        },
        "validator": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "definitions": {
    "enabledBlock": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}

# Example kubeconfig placeholder.
# Do not commit a real kubeconfig, client certificate, or client key here.
# Generate a local sandbox kubeconfig with `ubiquity up --sandbox` or `k3d kubeconfig get ubiquity-dev > metal/kubeconfig.yaml`.
apiVersion: v1
kind: Config
clusters:
- name: example-cluster
  cluster:
    server: https://127.0.0.1:6443
    certificate-authority-data: REDACTED
contexts:
- name: example-context
  context:
    cluster: example-cluster
    user: example-user
current-context: example-context
users:
- name: example-user
  user:
    client-certificate-data: REDACTED
    client-key-data: REDACTED
